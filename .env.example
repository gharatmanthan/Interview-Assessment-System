# InterviewIQ environment variables.
# Copy this file to `.env` and fill in real values. `.env` is gitignored —
# never commit real keys.

# =============================================================================
# Core Application
# =============================================================================

# Optional: Groq API key for LLM scoring/explanations/fairness/JD matching.
# Without it the system falls back to rule-based heuristics (logged, never silent).
GROQ_API_KEY=

# Required for production: HMAC signing secret for auth tokens.
# Generate with: openssl rand -hex 32
AUTH_SECRET=

# Required for central deployment: binds the API to 0.0.0.0 so external
# browsers/desktop apps can reach it over HTTPS.
DEPLOY_MODE=remote

# =============================================================================
# Database (PostgreSQL for production, SQLite for local dev)
# =============================================================================

# PostgreSQL connection string for production.
# Format: postgresql://user:password@host:port/database
# Leave empty for local SQLite development.
DATABASE_URL=

# =============================================================================
# File Storage (S3-compatible for production, local filesystem for dev)
# =============================================================================

# Storage backend: "local" or "s3"
STORAGE_BACKEND=local

# S3 configuration (required when STORAGE_BACKEND=s3)
S3_BUCKET=
S3_REGION=us-east-1
S3_ENDPOINT_URL=          # Optional: for S3-compatible services (MinIO, etc.)
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_PREFIX=                # Optional: prefix for all objects (e.g., "interviewiq/")

# =============================================================================
# Frontend / Public URLs (external candidates)
# =============================================================================

# ---- Frontend environment (frontend/.env.local) ----
# Public origin of the APPLY / candidate pages. Used by the recruiter's
# "Copy Application Link" and any Next.js-rendered candidate links.
# In production this MUST be the real public domain, never localhost.
NEXT_PUBLIC_APP_URL=http://localhost:3000
# Production:
# NEXT_PUBLIC_APP_URL=https://<frontend-domain>

# Base URL of the FastAPI backend that the candidate browser calls.
# Never point this at a machine-localhost in production — an external
# candidate's browser must NOT call its own host.
NEXT_PUBLIC_API_URL=http://localhost:8000
# Production:
# NEXT_PUBLIC_API_URL=https://<backend-domain>

# ---- Backend environment (backend .env) ----
# Public origin of the frontend (the app that serves /apply and /settings).
# Used for the public application link inside generated LinkedIn posts and for
# the post-OAuth redirect target. Defaults to http://localhost:3000.
PUBLIC_APP_URL=https://<frontend-domain>

# CORS allow-list for the frontend origin (fixed-origin approach).
# Must match the deployed frontend domain exactly.
FRONTEND_ORIGIN=https://<frontend-domain>

# =============================================================================
# OAuth Redirect URIs (Production Configuration)
# =============================================================================

# These MUST be registered EXACTLY in each provider's console (no trailing slash).
# For local development with Electron, they can point to localhost.
# For production, they must point to your deployed backend domain.

# Gmail OAuth redirect URI (for email intake pipeline)
# Register in Google Cloud Console: https://console.cloud.google.com/apis/credentials
# Example: https://api.yourdomain.com/api/settings/gmail/callback
GMAIL_REDIRECT_URI=

# Google Calendar OAuth redirect URI (for auto-scheduling)
# Register in Google Cloud Console (same project as Gmail)
# Example: https://api.yourdomain.com/api/settings/calendar/callback
CALENDAR_REDIRECT_URI=

# LinkedIn OAuth redirect URI (for member posting)
# Register in LinkedIn Developer Portal: https://www.linkedin.com/developers/apps
# Example: https://api.yourdomain.com/api/integrations/linkedin/callback
LINKEDIN_REDIRECT_URI=

# =============================================================================
# LinkedIn Integration (recruiter member posting)
# =============================================================================

# Create a LinkedIn app at https://www.linkedin.com/developers/apps (Products ->
# "Sign In with LinkedIn using OpenID Connect" + "Share on LinkedIn" aka the
# w_member_social scope). Member posting only — organization/company page
# posting is NOT implemented (it additionally requires the w_organization_social
# scope and ADMINISTRATOR/DIRECT_SPONSORED_CONTENT_POSTER roles).

LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=

# =============================================================================
# Background Workers
# =============================================================================

# Set to "1" to disable in-process background workers (screening, outbox, Gmail polling).
# Use this for the web service when running separate worker process.
# Worker process should run with this UNSET or "0".
INTERVIEWIQ_DISABLE_WORKERS=0

# =============================================================================
# Local Development Overrides (not for production)
# =============================================================================

# Override data directory (default: repo/data/ in dev, %APPDATA%/InterviewIQ in Electron)
# INTERVIEWIQ_DATA_DIR=

# Override Whisper model directory (default: bundled in Electron, HF cache in dev)
# INTERVIEWIQ_WHISPER_MODEL_DIR=

# =============================================================================
# NOTES
# =============================================================================

# .env is gitignored — never commit real keys.
# client_secret.json (Google OAuth) is gitignored — place in data/ directory.
# settings.json (runtime config) is gitignored — created at runtime.
# For production: use a secrets manager or platform environment variables.