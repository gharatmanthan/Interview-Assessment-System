{
  "name": "interviewiq",
  "version": "1.0.0",
  "private": true,
  "description": "AI-Powered Interview Assessment System",
  "scripts": {
    "build:frontend": "cd frontend && npm run build",
    "build:electron": "cd electron && npm run build",
    "build:python": "cd .. && pip install -r requirements.txt",
    "build": "npm run build:frontend && npm run build:electron",
    "start": "cd electron && npm run start",
    "install:all": "cd frontend && npm install && cd ../electron && npm install"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "concurrently": "^9.0.0",
    "electron": "^43.4.1",
    "typescript": "^7.0.2"
  }
}
