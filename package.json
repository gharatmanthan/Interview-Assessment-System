{
  "name": "interviewiq",
  "version": "1.0.0",
  "private": true,
  "description": "AI-Powered Interview Assessment System",
  "scripts": {
    "dev:frontend": "cd frontend && npm run dev",
    "dev:electron": "cd electron && npm run dev",
    "start:electron": "cd electron && npm start",
